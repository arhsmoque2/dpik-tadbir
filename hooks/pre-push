#!/usr/bin/env bash
# Full local quality gate before a push leaves the machine — the same
# checks ci.yml's Gate 1/3 will run, so a push that passes this rarely
# comes back red. This is what turns "discover it after CI burns Actions
# minutes and you're polling for the result" into "discover it locally,
# in seconds, before the push even happens."
#
# Deliberately not run on every commit (see hooks/pre-commit) — this boots
# PHPStan, the full Pest suite, and diff-cover, which is too slow for that.
#
# Installed by scripts/install-git-hooks.sh — not automatic on a bare clone.
set -euo pipefail

if [ ! -f scripts/sandbox-preflight.sh ]; then
  exit 0
fi

bash scripts/sandbox-preflight.sh
