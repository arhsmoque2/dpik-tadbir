{
  "$schema": "https://arh-os.dev/schemas/arh-project-manifest.v1.json",
  "name": "dpik-tadbir",
  "description": "Executive Email Copilot & Enterprise Knowledge Workstation for DPIK",
  "ecosystem": "laravel",

  "control_plane": {
    "entry_point": "tools/tadbir.py",
    "cli": "python tools/tadbir.py",
    "composer_prefix": "composer tadbir:"
  },

  "stack": {
    "runtime": "php:^8.4",
    "framework": "laravel:^12.0",
    "ui": "filament:^4.0",
    "package_manager": "composer"
  },

  "gates": {
    "quick": "composer check:quick",
    "full": "composer check:full",
    "fast": "python tools/tadbir.py gate",
    "fix": "composer fix",
    "status": "python tools/tadbir.py status",
    "individual": {
      "lint": "vendor/bin/pint --test",
      "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
      "test": "vendor/bin/pest --ci",
      "test:coverage": "composer test:coverage",
      "test:mutate": "composer test:mutate"
    }
  },

  "ci": {
    "provider": "github-actions",
    "workflow": ".github/workflows/ci.yml",
    "gate_names": ["pint", "phpstan-l8", "filacheck", "pest", "composer-unused", "mdlint", "gitleaks", "diff-cover"]
  },

  "continuity": {
    "state_file": "CURRENT_STATE.md",
    "design_doc": "docs/DESIGN.md",
    "adr_dir": "docs/adr/"
  },

  "phase": {
    "current": "Session Export & IMAP Control Plane (ADR-024 to ADR-028) Merged & Verified",
    "next_action": "Run tadbir status, verify runtime gates, and proceed with next milestone",
    "updated_at": "2026-09-01T23:55:00+08:00"
  }
}
